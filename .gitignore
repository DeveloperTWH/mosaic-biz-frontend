# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/quality-reports/
/playwright-report/
/test-results/
/blob-report/
/.playwright/
# Lighthouse CI temp output (assertion-results.json, lhr-*.json/html)
.lighthouseci/

# next.js
/out/
.next
.next/cache/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
