    "@types/d3": "^7.4.3",
    "@types/google.maps": "^3.58.1",
    "@types/js-cookie": "^3.0.6",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/react-google-recaptcha": "^2.1.9",
    "@types/topojson-client": "^3.1.5",
    "autoprefixer": "^10.4.21",
    "eslint": "^9.39.4",
