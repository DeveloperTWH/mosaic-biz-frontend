{
  "name": "frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:report": "playwright show-report",
    "quality:scan": "node scripts/run-quality-scan.mjs",
    "quality:scan:playwright": "playwright test --config=playwright.quality.config.ts",
    "quality:scan:lighthouse": "lhci autorun --config=lighthouserc.cjs && lhci autorun --config=lighthouserc.mobile.cjs",
    "quality:scan:report": "node -e \"console.log(require('fs').readFileSync('quality-reports/summary.md','utf8'))\""
  },
